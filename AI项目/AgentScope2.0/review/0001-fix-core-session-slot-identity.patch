+package io.agentscope.core.agent;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import io.agentscope.core.ReActAgent;
+import io.agentscope.core.agent.test.MockModel;
+import io.agentscope.core.message.GenerateReason;
+import io.agentscope.core.message.Msg;
+import io.agentscope.core.message.UserMessage;
+import io.agentscope.core.middleware.MiddlewareBase;
+import io.agentscope.core.state.AgentState;
+import io.agentscope.core.state.InMemoryAgentStateStore;
+import java.time.Duration;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+import reactor.core.publisher.Sinks;
+
+class ReActAgentSlotIdentityTest {
+    private static final Duration TIMEOUT = Duration.ofSeconds(5);
+
+    @Test
+    void delimiterInEitherComponentDoesNotAliasStateOrCacheEviction() {
+        try (ReActAgent agent = ReActAgent.builder().model(new MockModel("ok")).build()) {
+            AgentState first = agent.getAgentState("tenant/alice", "conversation");
+            AgentState second = agent.getAgentState("tenant", "alice/conversation");
+
+            assertNotSame(first, second);
+            first.setSummary("private to alice");
+            assertFalse("private to alice".equals(second.getSummary()));
+            agent.clearStateCache("tenant/alice", "conversation");
+            assertSame(second, agent.getAgentState("tenant", "alice/conversation"));
+            assertNotSame(first, agent.getAgentState("tenant/alice", "conversation"));
+        }
+    }
+
+    @Test
+    void literalAnonymousMarkerDoesNotAliasAnonymousCachedState() {
+        try (ReActAgent agent = ReActAgent.builder().model(new MockModel("ok")).build()) {
+            assertNotSame(
+                    agent.getAgentState(null, "conversation"),
+                    agent.getAgentState("__anon__", "conversation"));
+            assertSame(
+                    agent.getAgentState(null, "conversation"),
+                    agent.getAgentState("  ", "conversation"));
+        }
+    }
+
+    @Test
+    void callPersistsAndRestoresTheOriginalSessionPairContainingSlashes() {
+        InMemoryAgentStateStore store = new InMemoryAgentStateStore();
+        RuntimeContext ctx = context("tenant/alice", "project/conversation");
+        try (ReActAgent agent =
+                ReActAgent.builder().model(new MockModel("ok")).stateStore(store).build()) {
+            agent.call(List.of(new UserMessage("remember this")), ctx).block(TIMEOUT);
+            assertTrue(
+                    store.get(
+                                    "tenant/alice",
+                                    "project/conversation",
+                                    "agent_state",
+                                    AgentState.class)
+                            .isPresent());
+            assertFalse(store.exists("tenant/alice/project", "conversation"));
+        }
+        try (ReActAgent restored =
+                ReActAgent.builder().model(new MockModel("ok")).stateStore(store).build()) {
+            assertTrue(
+                    restored
+                            .getAgentState("tenant/alice", "project/conversation")
+                            .getContext()
+                            .stream()
+                            .anyMatch(m -> "remember this".equals(m.getTextContent())));
+        }
+    }
+
+    @Test
+    void anonymousSessionContainingSlashesStaysInAnonymousStoreNamespace() {
+        InMemoryAgentStateStore store = new InMemoryAgentStateStore();
+        try (ReActAgent agent =
+                ReActAgent.builder().model(new MockModel("ok")).stateStore(store).build()) {
+            agent.call(List.of(new UserMessage("hello")), context(null, "project/conversation"))
+                    .block(TIMEOUT);
+            assertTrue(store.exists(null, "project/conversation"));
+            assertFalse(store.exists("__anon__/project", "conversation"));
+        }
+    }
+
+    @Test
+    void collidingConcatenationsRunIndependentlyAndInterruptOnlyTheTarget() {
+        Map<String, Sinks.One<String>> gates = new ConcurrentHashMap<>();
+        MiddlewareBase middleware =
+                new MiddlewareBase() {
+                    @Override
+                    public Mono<String> onSystemPrompt(
+                            Agent agent, RuntimeContext ctx, String prompt) {
+                        Sinks.One<String> gate = Sinks.one();
+                        gates.put(ctx.getUserId(), gate);
+                        return gate.asMono();
+                    }
+                };
+        try (ReActAgent agent =
+                ReActAgent.builder().model(new MockModel("ok")).middleware(middleware).build()) {
+            AgentRun<Msg> first =
+                    agent.prepareCall(
+                            List.of(new UserMessage("one")),
+                            context("tenant/alice", "conversation"));
+            AgentRun<Msg> second =
+                    agent.prepareCall(
+                            List.of(new UserMessage("two")),
+                            context("tenant", "alice/conversation"));
+            var firstResult =
+                    first.stream()
+                            .single()
+                            .toFuture()
+                            .orTimeout(5, java.util.concurrent.TimeUnit.SECONDS);
+            var secondResult =
+                    second.stream()
+                            .single()
+                            .toFuture()
+                            .orTimeout(5, java.util.concurrent.TimeUnit.SECONDS);
+            try {
+                assertEquals(AgentRun.Status.RUNNING, first.status());
+                assertEquals(AgentRun.Status.RUNNING, second.status());
+                agent.interrupt("tenant", "alice/conversation");
+                assertEquals(Sinks.EmitResult.OK, gates.get("tenant/alice").tryEmitValue("system"));
+                assertEquals(Sinks.EmitResult.OK, gates.get("tenant").tryEmitValue("system"));
+                assertFalse(firstResult.join().getGenerateReason() == GenerateReason.INTERRUPTED);
+                assertEquals(GenerateReason.INTERRUPTED, secondResult.join().getGenerateReason());
+            } finally {
+                first.cancel();
+                second.cancel();
+            }
+        }
+    }
+
+    private static RuntimeContext context(String userId, String sessionId) {
+        return RuntimeContext.builder().userId(userId).sessionId(sessionId).build();
+    }
+}
