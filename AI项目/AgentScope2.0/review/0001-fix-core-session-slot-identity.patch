         method.setAccessible(true);
-        return (long) method.invoke(agent, "u", "s", "u/s", state, AgentStateStore.UNVERSIONED, 0);
+        return (long) method.invoke(agent, "u", "s", slot, state, AgentStateStore.UNVERSIONED, 0);
     }
 
     @Test
